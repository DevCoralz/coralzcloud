# Coralz Cloud — Backend Environment Variables
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# The public URL this backend is reached at. In production this is your
# Cloudflare Tunnel hostname (e.g. https://api.yourdomain.com). Never
# hardcode this anywhere in the codebase — it is only ever read from here.
PUBLIC_BACKEND_URL=http://localhost:4000

# Where the frontend is served from. Used for CORS + cookie behavior.
FRONTEND_URL=http://localhost:3000

# Comma-separated list of additional allowed CORS origins (optional).
# If unset, defaults to FRONTEND_URL only.
ALLOWED_ORIGINS=http://localhost:3000

# Set to "true" once this backend runs behind the Cloudflare Tunnel (or any
# reverse proxy), so Express trusts X-Forwarded-* headers correctly.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Full connection string, e.g.:
# postgresql://coralz_user:password@localhost:5432/coralz_cloud
DATABASE_URL=postgresql://coralz_user:CHANGE_ME@localhost:5432/coralz_cloud

# Set to "true" if your Postgres provider requires SSL (most managed
# providers do — Render, Railway, Supabase, RDS, etc.)
DATABASE_SSL=false

# Max connections in the pool.
DB_POOL_MAX=10

# ---------------------------------------------------------------------------
# Sessions / Authentication
# ---------------------------------------------------------------------------
# Long, random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

SESSION_COOKIE_NAME=coralz.sid

# Session lifetime in milliseconds. Default: 7 days.
SESSION_MAX_AGE_MS=604800000

# Set to "true" in production (requires HTTPS, e.g. behind the Cloudflare
# Tunnel). Must be "false" for local HTTP development.
SESSION_SECURE_COOKIE=false

# ---------------------------------------------------------------------------
# Rate limiting (auth endpoints)
# ---------------------------------------------------------------------------
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# ---------------------------------------------------------------------------
# Telegram / MTProto (GramJS) — storage foundation only, not used yet
# ---------------------------------------------------------------------------
# From https://my.telegram.org -> API Development Tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# A GramJS StringSession, generated once out-of-band via an interactive
# login script (not by this server). Keep this secret — it grants full
# access to the Telegram account it belongs to.
TELEGRAM_SESSION_STRING=

# The numeric ID of the private Telegram channel used as the cloud storage
# backend (created and implemented in a later phase).
TELEGRAM_STORAGE_CHANNEL_ID=

# How many times GramJS retries the MTProto connection before giving up.
TELEGRAM_CONNECTION_RETRIES=5

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# morgan format name: "dev" for local development, "combined" for production
LOG_LEVEL=dev
