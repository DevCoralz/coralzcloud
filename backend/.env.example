# Coralz Cloud API environment. Copy to `.env` (the app loads `.env`, NOT `env`).
DATABASE_URL=mysql://user:password@host:3306/database

CLOUDFLARE_TUNNEL_TOKEN=
# Comma-separated frontend origins allowed to call this API with cookies.
# Must be exact origins (scheme + host + port) — "*" is not allowed with cookies.
CORS_ORIGIN=http://localhost:3000
# Must be at least 32 characters.
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
TELEGRAM_STORAGE_CHANNEL_ID=
NODE_ENV=development
AUTH_COOKIE_SECURE=
AUTH_COOKIE_SAMESITE=
PORT=8000
