# Coralz Cloud API environment.
# Copy this file to `.env` (the app loads `.env`, NOT `env`).
#
# On Pterodactyl, most MySQL vars are auto-provided as MYSQL_HOST,
# MYSQL_PORT, MYSQL_DATABASE, MYSQL_USERNAME, MYSQL_PASSWORD.
# Only DATABASE_URL needs to be set if using a direct connection string.

# --- Database ---
# Direct URL (Pterodactyl format: jdbc:mysql://... — the app strips "jdbc:" automatically)
DATABASE_URL=mysql://user:password@host:3306/database

# --- Cloudflare Tunnel ---
# Leave empty to skip tunnel startup
CLOUDFLARE_TUNNEL_TOKEN=

# --- CORS ---
# Comma-separated frontend origins allowed to call this API with cookies.
# Must be exact origins (scheme + host + port) — "*" is not allowed with cookies.
# Production example: https://your-frontend.onrender.com
CORS_ORIGIN=http://localhost:3000

# --- Auth ---
# Must be at least 32 characters. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- Telegram MTProto Storage ---
# User account session string (NOT a bot token). User accounts get 2 GB upload limit.
# Generate with Telethon: https://docs.telethon.dev/en/stable/concepts/auth.html
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
# The private channel/group ID where files are stored (e.g. -1001234567890)
TELEGRAM_STORAGE_CHANNEL_ID=

# --- Server ---
NODE_ENV=production
PORT=8000

# --- Cookie Flags (optional) ---
# Leave blank to auto-derive from CORS_ORIGIN:
#   https-only origins -> Secure + SameSite=none (required for cross-origin)
#   http localhost -> not Secure + SameSite=lax
AUTH_COOKIE_SECURE=
AUTH_COOKIE_SAMESITE=
