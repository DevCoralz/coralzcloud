# Coralz Cloud — Frontend Environment Variables
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.
#
# Vite only exposes variables prefixed with VITE_ to client-side code —
# see https://vite.dev/guide/env-and-mode.html

# Base URL of the backend API (no trailing slash). In production this is
# your Cloudflare Tunnel hostname, e.g. https://api.yourdomain.com/api
VITE_API_URL=http://localhost:4000/api
