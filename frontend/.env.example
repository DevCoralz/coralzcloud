# Coralz Cloud — Frontend Environment Variables
# Copy this file to `.env`. Vite only exposes VITE_-prefixed vars to the client.
# Must be an absolute URL including scheme and the /api prefix.
# Local dev (backend default port is 8000):
VITE_API_URL=http://localhost:8000/api
# Production example: https://api.cloud.example.com/api
